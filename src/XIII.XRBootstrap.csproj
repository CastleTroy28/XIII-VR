<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>XIII.XRBootstrap</AssemblyName>
    <Version>0.1.242</Version>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The game's BepInEx folder (its core and interop folders, generated by BepInEx on the first game start): dotnet build -p:BepInExRoot="...\XIII\BepInEx" -->
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">BEPINEX_PATH</BepInExRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExRoot)/core/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExRoot)/core/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExRoot)/core/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(BepInExRoot)/interop/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VRModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.VRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.SubsystemsModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.SubsystemsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExRoot)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="_XIII"><HintPath>$(BepInExRoot)/interop/_XIII.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="_Plugins"><HintPath>$(BepInExRoot)/interop/_Plugins.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(BepInExRoot)/interop/Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes"><HintPath>$(BepInExRoot)/interop/Sirenix.OdinInspector.Attributes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(BepInExRoot)/interop/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(BepInExRoot)/interop/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VideoModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.VideoModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Cinemachine"><HintPath>$(BepInExRoot)/interop/Cinemachine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Postprocessing.Runtime"><HintPath>$(BepInExRoot)/interop/Unity.Postprocessing.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.DirectorModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.DirectorModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AIModule"><HintPath>$(BepInExRoot)/interop/UnityEngine.AIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
